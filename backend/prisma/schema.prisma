generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Pedido {
  id_pedido                             Int              @id @default(autoincrement())
  id_cliente                            Int
  id_repartidor                         Int
  fecha_creacion                        DateTime         @default(now()) @db.Timestamptz(6)
  fecha_entrega                         DateTime         @db.Timestamptz(6)
  direccion                             String
  referencia                            String
  notas_cliente                         String
  metodo_pago                           String           @db.VarChar
  comprobante                           String           @db.VarChar
  costo_envio                           Decimal          @db.Money
  total                                 Decimal          @db.Money
  estado_pedido                         EstadoPedido     @default(RECIBIDO)
  motivo_cancelacion                    String
  Usuario_Pedido_id_clienteToUsuario    Usuario?         @relation("Pedido_id_clienteToUsuario", fields: [id_cliente], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction, map: "fk_pedido_cliente")
  Usuario_Pedido_id_repartidorToUsuario Usuario?         @relation("Pedido_id_repartidorToUsuario", fields: [id_repartidor], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction, map: "fk_pedido_repartidor")
  detalle_pedido                        detalle_pedido[]
}

model Usuario {
  id_usuario                           Int       @id @default(autoincrement())
  id_rol                               Int
  primer_nombre                        String    @db.VarChar(20)
  segundo_nombre                       String    @db.VarChar(20)
  primer_apellido                      String    @db.VarChar(20)
  segundo_apellido                     String    @db.VarChar(20)
  correo                               String    @db.VarChar(50)
  password                             String    @db.VarChar(150)
  telefono                             String    @db.VarChar(20)
  estado                               Boolean
  fecha_registro                       DateTime  @db.Timestamptz(6)
  Pedido_Pedido_id_clienteToUsuario    Pedido[]  @relation("Pedido_id_clienteToUsuario")
  Pedido_Pedido_id_repartidorToUsuario Pedido[]  @relation("Pedido_id_repartidorToUsuario")
  rol_                                 rol_?     @relation(fields: [id_rol], references: [id_rol], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_rol")
  direcciones direccion_usuario[]
  metodos_pago metodo_pago_usuario[]
}

model categoria {
  id_categoria     Int        @id @default(autoincrement())
  nombre_categoria Categoria
  producto         producto[]
}

model detalle_pedido {
  id_detalle      Int      @id @default(autoincrement())
  id_pedido       Int
  id_producto     Int
  cantidad        Int
  precio_unitario Decimal  @db.Money
  subtotal        Decimal  @db.Money
  Pedido          Pedido   @relation(fields: [id_pedido], references: [id_pedido], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_pedido")
  producto        producto @relation(fields: [id_producto], references: [id_producto], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_producto")
}

model producto {
  id_producto    Int              @id @default(autoincrement())
  id_categoria   Int
  nombre         String           @db.VarChar(50)
  descripcion    String           @db.VarChar(50)
  imagen_url     String           @db.VarChar(255)
  precio         Decimal          @db.Money
  estado         Boolean
  fecha_registro DateTime         @db.Timestamptz(6)
  detalle_pedido detalle_pedido[]
  categoria      categoria        @relation(fields: [id_categoria], references: [id_categoria], onDelete: NoAction, onUpdate: NoAction, map: "fk_categoria")
}

model rol_ {
  id_rol     Int       @id @default(autoincrement())
  nombre_rol Rol
  Usuario    Usuario[]

  @@map("rol ")
}

enum Rol {
  GERENTE
  ADMIN
  CLIENTE
  REPARTIDOR
  COCINA
}

enum Categoria {
  HAMBURGUESAS
  POLLO
  BEBIDAS
}

enum EstadoPedido {
  RECIBIDO
  EN_PREPARACION
  LISTO_PARA_REPARTIDOR
  EN_CAMINO
  ENTREGADO
}

model direccion_usuario {
  id_direccion     Int      @id @default(autoincrement())
  id_usuario       Int
  nombre_direccion String   @db.VarChar(30)
  direccion        String   @db.VarChar(255)
  referencia       String?  @db.VarChar(255)
  es_principal     Boolean  @default(false)
  fecha_registro   DateTime @default(now()) @db.Timestamptz(6)

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
}

model metodo_pago_usuario {
  id_metodo_pago Int      @id @default(autoincrement())
  id_usuario     Int
  tipo           String   @db.VarChar(20)
  titular        String?  @db.VarChar(100)
  marca          String?  @db.VarChar(30)
  ultimos_digitos String? @db.VarChar(4)
  mes_expiracion Int?
  anio_expiracion Int?
  es_principal   Boolean  @default(false)
  fecha_registro DateTime @default(now()) @db.Timestamptz(6)

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
}
