{
  "name": "pink-pepper",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run start:dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "lint": "npm run lint --prefix backend && npm run lint --prefix frontend",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "clean:all": "npx rimraf node_modules backend/node_modules frontend/node_modules backend/dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoshuaBarahona/Pink_Pepper.git"
  },
  "bugs": {
    "url": "https://github.com/JoshuaBarahona/Pink_Pepper/issues"
  },
  "homepage": "https://github.com/JoshuaBarahona/Pink_Pepper#readme",
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "prisma": {
    "schema": "./backend/prisma/schema.prisma"
  }
}
